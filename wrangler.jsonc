{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "verdi-solarr",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "assets": {
    // Static files (HTML, JS, CSS, PDFs, images) are served by Cloudflare's asset
    // layer WITHOUT invoking the Worker (free + unlimited). Only /api/* runs the Worker.
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "verdi-db",
      // Replace with the id printed by `npx wrangler d1 create verdi-db` (see CLOUDFLARE_SETUP.md)
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    // Phase 2 admin uploads (images / datasheets). Create with `npx wrangler r2 bucket create verdi-media`.
    { "binding": "MEDIA", "bucket_name": "verdi-media" }
  ],
  "ratelimits": [
    { "name": "PUBLIC_LIMITER", "namespace_id": "4101", "simple": { "limit": 60, "period": 60 } },
    { "name": "ADMIN_LIMITER", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    // Cloudflare Access: team domain, e.g. https://verdi.cloudflareaccess.com  (set in CLOUDFLARE_SETUP.md)
    "ACCESS_TEAM_DOMAIN": "",
    // Comma-separated Access Application AUD tag(s)
    "ACCESS_AUD": "",
    // Comma-separated hostnames allowed to perform admin writes (CSRF/origin check), e.g. "verdisolarr.com,www.verdisolarr.com"
    "ADMIN_ALLOWED_HOSTS": "",
    "PUBLIC_CACHE_SECONDS": "60"
  }
}
